{
  "name": "@luxenx/backend",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "test": "vitest run",
    "start:local": "node --env-file=../../.env dist/index.js"
  },
  "dependencies": {
    "@luxenx/shared": "*",
    "@luxenx/validation": "*",
    "@upstash/redis": "^1.34.0",
    "express": "^5.1.0",
    "hash-wasm": "^4.12.0",
    "zod": "^4.0.0",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0",
    "@types/express": "^5.0.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.0"
  }
}
