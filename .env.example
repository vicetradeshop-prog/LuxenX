# ============================================================
# LuxenX — Configuration centrale
# ------------------------------------------------------------
# Copiez ce fichier vers ".env" (installer.bat le fait pour vous)
# puis remplissez les valeurs. Ne commitez JAMAIS le fichier .env.
# Les valeurs vides = fonctionnalité correspondante désactivée.
# ============================================================

# --- Upstash Redis (obligatoire pour le backend) ------------
# Console Upstash > votre base Redis > "REST API"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Backend -------------------------------------------------
# Port local du backend (défaut : 8787)
PORT=8787
# URL publique du backend une fois déployé (ex. https://luxenx-backend.onrender.com)
BACKEND_URL=http://localhost:8787
# Environnement : development | production
NODE_ENV=development
# Secret de signature des jetons de session (chaîne longue et aléatoire)
# Génération possible : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Durée de vie du jeton d'accès en secondes (défaut : 900 = 15 min)
ACCESS_TOKEN_TTL=900
# Durée de vie du jeton de rafraîchissement en secondes (défaut : 30 jours)
REFRESH_TOKEN_TTL=2592000

# --- Compte administrateur initial (créé par : npm run seed) --
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- GitHub (publication des mises à jour) --------------------
GITHUB_OWNER=
GITHUB_REPO=LuxenX
# Jeton GitHub — UNIQUEMENT pour le backend/la publication locale.
# Jamais distribué dans les applications clientes.
# Laisser vide si vous utilisez GitHub CLI (gh) à la place.
GITHUB_TOKEN=

# --- Render (déploiement du backend, optionnel) ---------------
RENDER_API_KEY=
RENDER_SERVICE_ID=

# --- Courriels (optionnel : confirmation / réinitialisation) --
# Sans configuration, les jetons de réinitialisation sont affichés
# dans les journaux du backend en mode développement uniquement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LuxenX <noreply@luxenx.local>
